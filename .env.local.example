# Local Development Environment Variables
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration (Get from https://supabase.com)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Configuration (Get from https://stripe.com)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-test-key-here

# Application URLs
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Feature Flags (true/false)
VITE_ENABLE_AUTO_SNIPE=true
VITE_ENABLE_MARKETPLACE_AUTO_LIST=false
VITE_ENABLE_REAL_TIME_SCANNER=true

# God Mode Configuration
VITE_GOD_MODE_EMAIL=admin@example.com

# Optional: API Keys for domain registrars (not needed for demo)
# GODADDY_API_KEY=
# NAMECHEAP_API_KEY=
# DROPCATCH_API_KEY=

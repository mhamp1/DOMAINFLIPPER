# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ===== Domain Registrar APIs (REQUIRED for domain operations) =====
# GoDaddy - Get API keys from https://developer.godaddy.com/keys
VITE_GODADDY_API_KEY=your-godaddy-api-key
VITE_GODADDY_API_SECRET=your-godaddy-api-secret
# Optional: OAuth credentials for advanced features
VITE_GODADDY_CLIENT_ID=your-godaddy-client-id
VITE_GODADDY_CLIENT_SECRET=your-godaddy-client-secret
VITE_GODADDY_USE_OAUTH=false

# Namecheap - Get API key from https://ap.www.namecheap.com/settings/tools/apiaccess/
# IMPORTANT: You must whitelist your IP address in Namecheap dashboard
VITE_NAMECHEAP_API_USER=your-namecheap-username
VITE_NAMECHEAP_API_KEY=your-namecheap-api-key
VITE_NAMECHEAP_CLIENT_IP=your-whitelisted-ip-address

# DropCatch - Get from https://dropcatch.com/api
VITE_DROPCATCH_API_KEY=your-dropcatch-api-key
VITE_DROPCATCH_API_SECRET=your-dropcatch-api-secret

# Registrant Information (for domain registration)
VITE_REGISTRANT_FIRST_NAME=Your-First-Name
VITE_REGISTRANT_LAST_NAME=Your-Last-Name
VITE_REGISTRANT_EMAIL=your-email@example.com
VITE_REGISTRANT_PHONE=+1.3105551234
VITE_REGISTRANT_ADDRESS=123 Main St
VITE_REGISTRANT_CITY=Los Angeles
VITE_REGISTRANT_STATE=CA
VITE_REGISTRANT_POSTAL=90001
VITE_REGISTRANT_COUNTRY=US

# Marketplace API Keys
VITE_SEDO_API_KEY=your-sedo-api-key
VITE_FLIPPA_API_KEY=your-flippa-api-key
VITE_AFTERNIC_API_KEY=your-afternic-api-key

# ===== Valuation & Intelligence APIs (Optional but recommended) =====
# EstiBot - Domain appraisal API - https://estibot.com/api
VITE_ESTIBOT_API_KEY=your-estibot-api-key

# USPTO - Trademark search (FREE, no key required in most cases)
VITE_USPTO_API_KEY=

# Ahrefs - SEO data - https://ahrefs.com/api
VITE_AHREFS_API_KEY=your-ahrefs-api-key

# NameBio - Historical domain sales data
VITE_NAMEBIO_API_KEY=your-namebio-api-key

# Google APIs - For trends and ads data
VITE_GOOGLE_API_KEY=your-google-api-key

# ExpiredDomains.net (via Apify)
VITE_APIFY_API_KEY=your-apify-api-key
VITE_APIFY_ACTOR_ID=your-expired-domains-actor-id

# Twitter/X API Keys (v2 API, 2025)
# For browser use, use VITE_ prefix. For server-side only, remove VITE_ prefix
VITE_TWITTER_BEARER_TOKEN=your-twitter-bearer-token-here
# Alternative naming:
# VITE_X_BEARER_TOKEN=your-x-bearer-token-here

# Reddit API Keys (for domain leads and market research)
# ⚠️ WARNING: In production, these should be server-side only (remove VITE_ prefix and proxy through backend)
VITE_REDDIT_CLIENT_ID=your-reddit-client-id
VITE_REDDIT_CLIENT_SECRET=your-reddit-client-secret
VITE_REDDIT_USERNAME=your-reddit-username
VITE_REDDIT_PASSWORD=your-reddit-password
VITE_REDDIT_USER_AGENT=DomainFlipper:v1.0.0

# Sedo Marketplace Credentials
# ⚠️ WARNING: In production, these should be server-side only (remove VITE_ prefix and proxy through backend)
VITE_SEDO_USERNAME=your-sedo-username
VITE_SEDO_PASSWORD=your-sedo-password
VITE_SEDO_API_KEY=your-sedo-api-key

# Web3/ENS/Blockchain Domain APIs
# Infura - For Ethereum ENS domains
VITE_INFURA_PROJECT_ID=your-infura-project-id
VITE_INFURA_MAINNET_URL=https://mainnet.infura.io/v3/your-project-id

# Alchemy - For Solana/NFT domains
VITE_ALCHEMY_API_KEY=your-alchemy-api-key
VITE_ALCHEMY_ETH_MAINNET=https://eth-mainnet.g.alchemy.com/v2/your-api-key
VITE_ALCHEMY_SOLANA_MAINNET=https://solana-mainnet.g.alchemy.com/v2/your-api-key
VITE_ALCHEMY_NFT_API=https://eth-mainnet.g.alchemy.com/nft/v2/your-api-key

# Application Configuration
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
VITE_SUBSCRIPTION_PRICE_ID=price_your-stripe-price-id
VITE_REVENUE_SHARE_PERCENTAGE=20

# God Mode Configuration (Creator Access)
VITE_GOD_MODE_EMAIL=admin@domainflipper.com
GOD_MODE_SECRET=your-ultra-secure-secret-key

# AI Model Configuration
VITE_AI_MODEL_URL=/models/domain-valuation-v1.json
VITE_AI_ACCURACY_TARGET=94

# Feature Flags
VITE_ENABLE_AUTO_SNIPE=true
VITE_ENABLE_MARKETPLACE_AUTO_LIST=true
VITE_ENABLE_REAL_TIME_SCANNER=true
VITE_SNIPE_LAST_SECONDS=3

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# API Keys for Domain Registrars
GODADDY_API_KEY=your-godaddy-api-key
GODADDY_API_SECRET=your-godaddy-api-secret
NAMECHEAP_API_USER=your-namecheap-username
NAMECHEAP_API_KEY=your-namecheap-api-key
DROPCATCH_API_KEY=your-dropcatch-api-key

# Marketplace API Keys
SEDO_API_KEY=your-sedo-api-key
FLIPPA_API_KEY=your-flippa-api-key
AFTERNIC_API_KEY=your-afternic-api-key

# Application Configuration
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
VITE_SUBSCRIPTION_PRICE_ID=price_your-stripe-price-id
VITE_REVENUE_SHARE_PERCENTAGE=20

# God Mode Configuration (Creator Access)
VITE_GOD_MODE_EMAIL=admin@domainflipper.com
GOD_MODE_SECRET=your-ultra-secure-secret-key

# AI Model Configuration
VITE_AI_MODEL_URL=/models/domain-valuation-v1.json
VITE_AI_ACCURACY_TARGET=94

# Feature Flags
VITE_ENABLE_AUTO_SNIPE=true
VITE_ENABLE_MARKETPLACE_AUTO_LIST=true
VITE_ENABLE_REAL_TIME_SCANNER=true
VITE_SNIPE_LAST_SECONDS=3
